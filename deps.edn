{:paths ["src" "resources"]
 :deps {org.clojure/clojure {:mvn/version "1.12.6"}
        datascript/datascript {:mvn/version "1.8.1"}
        http-kit/http-kit {:mvn/version "2.8.1"}
        hiccup/hiccup {:mvn/version "2.0.0"}
        org.clojure/data.json {:mvn/version "2.5.1"}}
 :aliases
 {:dev {:extra-paths ["dev"]
        :extra-deps {nrepl/nrepl {:mvn/version "1.8.0"}}
        :main-opts ["-m" "nrepl.cmdline"]}
  :prod {:extra-deps {nrepl/nrepl {:mvn/version "1.8.0"}}
         :main-opts ["-m" "kino.main"]}}}
